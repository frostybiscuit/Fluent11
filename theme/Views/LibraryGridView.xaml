<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:vwp="clr-namespace:WpfToolkit.Controls;assembly=VirtualizingWrapPanel"
                    mc:Ignorable="d">

    <Style TargetType="{x:Type vwp:VirtualizingWrapPanel}">
        <Setter Property="StretchItems" Value="True" />
    </Style>

    <Style TargetType="{x:Type LibraryGridView}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type LibraryGridView}">
                    <Grid Background="{TemplateBinding Background}"
                          d:DesignWidth="1280" d:DesignHeight="960"
                          d:DataContext="{x:Static DesignMainViewModel.DesignIntance}">
                    <DockPanel x:Name="GridLayer">
                        <Grid DockPanel.Dock="Left">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ExtendedListBox x:Name="PART_ListGames" FocusVisualStyle="{x:Null}" Padding="16,16,16,0" Grid.RowSpan="2"
                                             VirtualizingPanel.CacheLengthUnit="Page" VirtualizingPanel.CacheLength="1,1"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.PanningMode="VerticalOnly"
                                             ItemContainerStyle="{DynamicResource GridViewItemStyle}"
                                             DockPanel.Dock="Left"
                                             BorderThickness="0">
                                <ExtendedListBox.Resources>
                                    <Style TargetType="{x:Type ScrollViewer}" BasedOn="{StaticResource BaseStyle}">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type ScrollViewer}">
                                                    <Grid Background="{TemplateBinding Background}">
                                                        <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                                                Margin="{TemplateBinding Padding}" Content="{TemplateBinding Content}"
                                                                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                                CanContentScroll="{TemplateBinding CanContentScroll}" />
                                                        <ScrollBar x:Name="PART_VerticalScrollBar" HorizontalAlignment="Right"
                                                                   Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                                                   Value="{Binding Path=VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                                   ViewportSize="{TemplateBinding ViewportHeight}"
                                                                   Minimum="0" Maximum="{TemplateBinding ScrollableHeight}" Orientation="Vertical"
                                                                   AutomationProperties.AutomationId="VerticalScrollBar" />
                                                    </Grid>
                                                    <ControlTemplate.Triggers>
                                                        <EventTrigger RoutedEvent="Mouse.MouseEnter">
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimationUsingKeyFrames Storyboard.TargetName="PART_VerticalScrollBar" Storyboard.TargetProperty="Opacity">
                                                                        <LinearDoubleKeyFrame KeyTime="0:0:0.12" Value="1" />
                                                                        <DiscreteDoubleKeyFrame KeyTime="0:0:1.6" Value="1" />
                                                                        <LinearDoubleKeyFrame KeyTime="0:0:1.9" Value="0" />
                                                                    </DoubleAnimationUsingKeyFrames>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </EventTrigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ExtendedListBox.Resources>
                                <ExtendedListBox.ItemTemplate>
                                    <DataTemplate>
                                        <GameListItem Style="{StaticResource GridViewItemTemplate}" />
                                    </DataTemplate>
                                </ExtendedListBox.ItemTemplate>
                                <ExtendedListBox.GroupStyle>
                                    <GroupStyle ContainerStyle="{StaticResource GridViewGroupStyle}"/>
                                </ExtendedListBox.GroupStyle>
                            </ExtendedListBox>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24" IsHitTestVisible="False">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Items.Count, ElementName=PART_ListGames, Mode=OneWay}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="&#xE80F;" FontFamily="{DynamicResource FluentIconFont}" FontSize="48"
                                           Foreground="{DynamicResource TextBrushDarker}" HorizontalAlignment="Center" Margin="0,0,0,16" />
                                <TextBlock Text="No games to show" TextWrapping="Wrap" TextAlignment="Center"
                                           FontSize="{DynamicResource FontSizeLarge}" FontWeight="SemiBold" HorizontalAlignment="Center"
                                           Style="{StaticResource BaseTextBlockStyle}" />
                                <TextBlock Text="No games match the current search or filter." TextAlignment="Center" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,4,0,0"
                                           Foreground="{DynamicResource TextBrushDarker}" Style="{StaticResource BaseTextBlockStyle}" />
                            </StackPanel>
                            <Border Grid.RowSpan="2" Height="72" VerticalAlignment="Bottom" IsHitTestVisible="False">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{PluginSettings Plugin=Fluent11Helper, Path=MainAreaPanel, FallbackValue=True}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Offset="0" Color="{DynamicResource LayerFadeColor}" />
                                        <GradientStop Offset="1" Color="{DynamicResource LayerFadeEndColor}" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                            <Grid x:Name="ZoomHost" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,12,8" Opacity="0.8">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{PluginSettings Plugin=Fluent11Helper, Path=ShowZoomButton, FallbackValue=True}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Border Style="{DynamicResource PopupShadow}" />
                                <Border x:Name="ZoomBorder" Style="{DynamicResource PopupBorder}" Padding="0" Height="40" Width="40"
                                        HorizontalAlignment="Right" ClipToBounds="True">
                                    <Grid>
                                    <StackPanel x:Name="ZoomExpanded" Orientation="Horizontal" Margin="12,0,5,0" HorizontalAlignment="Right">
                                        <StackPanel.Resources>
                                            <Style x:Key="ZoomIconButton" TargetType="{x:Type RepeatButton}">
                                                <Setter Property="OverridesDefaultStyle" Value="True" />
                                                <Setter Property="Focusable" Value="False" />
                                                <Setter Property="Width" Value="28" />
                                                <Setter Property="Height" Value="28" />
                                                <Setter Property="Delay" Value="300" />
                                                <Setter Property="Interval" Value="40" />
                                                <Setter Property="Cursor" Value="Hand" />
                                                <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="{x:Type RepeatButton}">
                                                            <Border x:Name="Fill" Background="Transparent" CornerRadius="{DynamicResource ControlCornerRadius}">
                                                                <TextBlock Text="{TemplateBinding Content}" FontFamily="{DynamicResource FluentIconFont}" FontSize="14"
                                                                           Foreground="{TemplateBinding Foreground}"
                                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource SubtleHoverBrush}" TargetName="Fill" />
                                                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                                                </Trigger>
                                                                <Trigger Property="IsPressed" Value="True">
                                                                    <Setter Property="Background" Value="{DynamicResource SubtlePressedBrush}" TargetName="Fill" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                            <Style TargetType="{x:Type SliderEx}" BasedOn="{StaticResource {x:Type SliderEx}}">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="{x:Type Slider}">
                                                            <DockPanel>
                                                                <RepeatButton DockPanel.Dock="Left" Style="{StaticResource ZoomIconButton}" Margin="0,0,6,0"
                                                                              Content="&#xE71F;" Command="{x:Static Slider.DecreaseSmall}" />
                                                                <RepeatButton DockPanel.Dock="Right" Style="{StaticResource ZoomIconButton}" Margin="6,0,0,0"
                                                                              Content="&#xE8A3;" Command="{x:Static Slider.IncreaseSmall}" />
                                                                <Grid VerticalAlignment="Center">
                                                                    <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}" />
                                                                    <Border Height="4" CornerRadius="2" HorizontalAlignment="Left"
                                                                            Background="{DynamicResource AccentBrush}"
                                                                            Width="{Binding ActualWidth, ElementName=ButtonDecrease}" />
                                                                    <Track x:Name="PART_Track">
                                                                        <Track.Thumb>
                                                                            <Thumb Style="{DynamicResource SliderThumb}" />
                                                                        </Track.Thumb>
                                                                        <Track.DecreaseRepeatButton>
                                                                            <RepeatButton x:Name="ButtonDecrease" Style="{DynamicResource SliderTrackButton}"
                                                                                          Command="Slider.DecreaseLarge" />
                                                                        </Track.DecreaseRepeatButton>
                                                                        <Track.IncreaseRepeatButton>
                                                                            <RepeatButton Style="{DynamicResource SliderTrackButton}"
                                                                                          Command="Slider.IncreaseLarge" />
                                                                        </Track.IncreaseRepeatButton>
                                                                    </Track>
                                                                </Grid>
                                                            </DockPanel>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </StackPanel.Resources>
                                        <SliderWithPopup x:Name="PART_SliderZoom" Width="220" VerticalAlignment="Center">
                                            <SliderWithPopup.Style>
                                                <Style TargetType="{x:Type SliderWithPopup}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{PluginSettings Plugin=Fluent11Helper, Path=GridFitWindow, FallbackValue=False}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </SliderWithPopup.Style>
                                        </SliderWithPopup>
                                        <DockPanel Width="220" VerticalAlignment="Center">
                                            <DockPanel.Style>
                                                <Style TargetType="DockPanel">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{PluginSettings Plugin=Fluent11Helper, Path=GridFitWindow, FallbackValue=False}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DockPanel.Style>
                                            <TextBlock DockPanel.Dock="Left" Width="24" TextAlignment="Center" VerticalAlignment="Center" ToolTip="{DynamicResource LOCColumns}"
                                                       Foreground="{DynamicResource TextBrushDarker}"
                                                       Text="{PluginSettings Plugin=Fluent11Helper, Path=GridColumns, FallbackValue=''}" />
                                            <SliderEx VerticalAlignment="Center" Minimum="2" Maximum="12" SmallChange="1" LargeChange="1"
                                                      IsSnapToTickEnabled="True" TickFrequency="1"
                                                      Value="{PluginSettings Plugin=Fluent11Helper, Path=GridColumnsZoom, Mode=TwoWay, FallbackValue=7}" />
                                        </DockPanel>
                                    </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </DockPanel>

                    <Border x:Name="Fluent11OverlayBackdrop" Background="{DynamicResource OverlayDimBrush}" Margin="-1,-1,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{PluginSettings Plugin=Fluent11Helper, Path=GridOverlayActive, FallbackValue=False}" Value="True" />
                                            <Condition Binding="{PluginSettings Plugin=Fluent11Helper, Path=GridOverlayOpen, FallbackValue=False}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Visible" />
                                    </MultiDataTrigger>
                                    <DataTrigger Binding="{PluginSettings Plugin=Fluent11Helper, Path=GridOverlayFull, FallbackValue=False}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsVisible, RelativeSource={RelativeSource Self}}" Value="True" />
                                            <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <MultiDataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.15" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </MultiDataTrigger.EnterActions>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>

                    <Grid x:Name="OverviewHost">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{PluginSettings Plugin=Fluent11Helper, Path=GridOverlayActive, FallbackValue=False}" Value="True">
                                        <Setter Property="Visibility" Value="{Binding Visibility, ElementName=PART_ControlGameView}" />
                                        <Setter Property="MaxWidth" Value="{Binding ActualWidth, ElementName=GridLayer, Converter={StaticResource MathConverter}, ConverterParameter='Min(1366,Max(960,x*0.6))'}" />
                                        <Setter Property="Margin" Value="48,44" />
                                    </DataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{PluginSettings Plugin=Fluent11Helper, Path=GridOverlayActive, FallbackValue=False}" Value="True" />
                                            <Condition Binding="{PluginSettings Plugin=Fluent11Helper, Path=GridOverlayFull, FallbackValue=False}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="MaxWidth" Value="Infinity" />
                                        <Setter Property="Margin" Value="0" />
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{PluginSettings Plugin=Fluent11Helper, Path=GridOverlayActive, FallbackValue=False}" Value="True" />
                                            <Condition Binding="{PluginSettings Plugin=Fluent11Helper, Path=GridOverlayOpen, FallbackValue=False}" Value="False" />
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{PluginSettings Plugin=Fluent11Helper, Path=GridOverlayActive, FallbackValue=False}" Value="True" />
                                            <Condition Binding="{Binding IsVisible, RelativeSource={RelativeSource Self}}" Value="True" />
                                            <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True" />
                                        </MultiDataTrigger.Conditions>
                                        <MultiDataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.1" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </MultiDataTrigger.EnterActions>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.Resources>
                            <Style x:Key="OverlayFloatingButton" TargetType="Button">
                                <Setter Property="OverridesDefaultStyle" Value="True" />
                                <Setter Property="Width" Value="40" />
                                <Setter Property="Height" Value="32" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="Foreground" Value="{DynamicResource TextBrushDarker}" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Grid>
                                                <Border Background="{DynamicResource PopupBackgroundBrush}" Opacity="0.8"
                                                        CornerRadius="{DynamicResource ControlCornerRadius}" />
                                                <Border BorderBrush="{DynamicResource PopupBorderBrush}" BorderThickness="1"
                                                        CornerRadius="{DynamicResource ControlCornerRadius}" />
                                                <Border Background="{TemplateBinding Background}" CornerRadius="3" Margin="1" />
                                                <TextBlock x:Name="Glyph" Text="{TemplateBinding Content}" FontFamily="{DynamicResource FluentIconFont}" FontSize="12"
                                                           Foreground="{TemplateBinding Foreground}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock.RenderTransform>
                                                        <TranslateTransform />
                                                    </TextBlock.RenderTransform>
                                                </TextBlock>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding Content, RelativeSource={RelativeSource Self}}" Value="&#xE72B;" />
                                                        <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True" />
                                                        <Condition Binding="{Binding Source={x:Static SystemParameters.ClientAreaAnimation}}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <MultiDataTrigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="Glyph" Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)"
                                                                                 To="-2" Duration="0:0:0.1">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </MultiDataTrigger.EnterActions>
                                                    <MultiDataTrigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation Storyboard.TargetName="Glyph" Storyboard.TargetProperty="RenderTransform.(TranslateTransform.X)"
                                                                                 To="0" Duration="0:0:0.15" FillBehavior="Stop">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <CubicEase EasingMode="EaseOut" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </MultiDataTrigger.ExitActions>
                                                </MultiDataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SubtleHoverBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource SubtlePressedBrush}" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Resources>
                        <Border x:Name="OverlayShadow" Style="{DynamicResource PopupShadow}" Visibility="Collapsed" />
                        <Border x:Name="OverlayCard" Style="{DynamicResource PopupBorder}" Visibility="Collapsed" />
                        <Border x:Name="OverlayFullCard" Background="{DynamicResource LayerBrush}" CornerRadius="7,0,0,0" Visibility="Collapsed" />
                        <GridViewGameOverview x:Name="PART_ControlGameView" />
                        <Button x:Name="OverlayClose" Tag="Fluent11CloseOverlay" Visibility="Collapsed" Content="&#xE8BB;"
                                Style="{StaticResource OverlayFloatingButton}"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,9,13,0" ToolTip="{DynamicResource LOCCloseLabel}" />
                        <Button x:Name="OverlayBack" Tag="Fluent11CloseOverlay" Visibility="Collapsed" Content="&#xE72B;"
                                Style="{StaticResource OverlayFloatingButton}"
                                HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,12,0,0" ToolTip="{DynamicResource LOCBackLabel}" />
                    </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{PluginSettings Plugin=Fluent11Helper, Path=GridOverlayActive, FallbackValue=False}" Value="True">
                            <Setter Property="Visibility" Value="Visible" TargetName="OverlayShadow" />
                            <Setter Property="Visibility" Value="Visible" TargetName="OverlayCard" />
                            <Setter Property="Visibility" Value="Visible" TargetName="OverlayClose" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{PluginSettings Plugin=Fluent11Helper, Path=GridOverlayActive, FallbackValue=False}" Value="True" />
                                <Condition Binding="{PluginSettings Plugin=Fluent11Helper, Path=GridOverlayFull, FallbackValue=False}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Collapsed" TargetName="OverlayShadow" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="OverlayCard" />
                            <Setter Property="Visibility" Value="Visible" TargetName="OverlayFullCard" />
                            <Setter Property="Visibility" Value="Collapsed" TargetName="OverlayClose" />
                            <Setter Property="Visibility" Value="Visible" TargetName="OverlayBack" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{PluginSettings Plugin=Fluent11Helper, Path=GridOverlayActive, FallbackValue=False}" Value="True" />
                                <Condition Binding="{PluginSettings Plugin=Fluent11Helper, Path=GridOverlayFull, FallbackValue=False}" Value="True" />
                                <Condition Binding="{PluginSettings Plugin=Fluent11Helper, Path=GridOverlayOpen, FallbackValue=False}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Hidden" TargetName="GridLayer" />
                            <Setter Property="Opacity" Value="{DynamicResource OverlayDetailsLayerOpacity}" TargetName="OverlayFullCard" />
                        </MultiDataTrigger>
                        <Trigger Property="IsMouseOver" Value="True" SourceName="ZoomHost">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ZoomBorder" Storyboard.TargetProperty="Width"
                                                         To="240" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="ZoomHost" Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ZoomBorder" Storyboard.TargetProperty="Width"
                                                         To="40" Duration="0:0:0.18">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="ZoomHost" Storyboard.TargetProperty="Opacity"
                                                         To="0.8" Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>